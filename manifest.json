{
  "manifest_version": 3,
  "name": "Glance Translate",
  "version": "0.1.0",
  "description": "Translate selected text with Chrome's on-device translator, keyless services or your own OpenRouter key.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://edge.microsoft.com/*",
    "https://translate.googleapis.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lang-panel.js",
        "listen.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Glance Translate",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Translate the selection"
    }
  }
}
